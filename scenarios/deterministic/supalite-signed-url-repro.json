  "id": "scn.supalite-signed-url-repro",
  "revision": "1",
  "title": "Focused repro: storage.createSignedUrl wire-contract isolation (upstream dswbx/lite-projects#64)",
  "description": "The minimal chain that isolates Supalite's createSignedUrl wire-contract behavior with Storage RLS held out of the experiment. A service_role actor (no Auth signup, no user, no RLS policy) creates a private bucket, uploads fixture bytes, calls storage.createSignedUrl through the official @supabase/supabase-js/@supabase/storage-js client, then redeems the client-constructed URL and the redeemed bytes are compared to the uploaded bytes. Nothing else runs: no copy/move/list/remove, no download-for-truth (the upload step already reports the authoritative bytesDigest). Upstream issue: Supalite's POST /storage/v1/object/sign/* returns JSON key `signedUrl` and a `/storage/v1`-prefixed path, while the official storage-js wire contract expects `signedURL` (capital) with no prefix, so the client builds a wrong redeemable URL. This scenario only MEASURES that; the fix belongs to Supalite upstream. Runs against supabase-local (reference) and Supalite 0.9.0 / 0.10.0 via explicit package profiles.",
  "tags": ["repro", "supalite", "storage", "signed-url", "upstream-64"],
  "seed": "64",
  "client": { "library": "supabase-js", "version": "2.97.0" },
  "requirements": [
    {
      "capability": "storage.bucket.create",
      "range": "^1.0.0",
      "accept": ["exact", "experimental"]
    },
    {
      "capability": "storage.object.write",
      "range": "^1.0.0",
      "accept": ["exact", "experimental"]
    },
    { "capability": "storage.object.read", "range": "^1.0.0", "accept": ["exact", "experimental"] },
    {
      "capability": "storage.signed-url.create",
      "range": "^1.0.0",
      "accept": ["exact", "experimental"]
    }
  ],
  "resources": [
