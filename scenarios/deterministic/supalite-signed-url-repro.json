      "id": "step.schema",
      "kind": "schema.apply",
      "phase": "bootstrap",
      "input": { "resourceId": "schema.storage-marker", "mode": "authoritative" }
    },
    {
      "id": "step.create-bucket",
      "kind": "storage.createBucket",
      "phase": "exercise",
      "actor": "actor.service",
      "dependsOn": ["step.schema"],
      "input": { "bucket": "sd-repro", "public": false }
    },
    {
      "id": "step.upload",
      "kind": "storage.upload",
      "phase": "exercise",
      "actor": "actor.service",
