{
  "name": "supadiff-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "boundary-check": "node scripts/boundary-check.mjs",
    "check": "pnpm boundary-check && pnpm lint && pnpm build && pnpm typecheck && pnpm format:check && pnpm test",
    "test:observations": "pnpm --filter @supadiff/engine test -- observation",
    "test:secret-corpus": "pnpm --filter @supadiff/engine test -- secret-corpus",
    "test:comparison-honesty": "pnpm --filter @supadiff/engine test -- comparison-honesty",
    "test:integration:supalite": "pnpm --filter @supadiff/targets exec vitest run --config vitest.integration.config.ts test/integration/supalite.test.ts",
    "test:integration:peer-data-auth-rls": "pnpm --filter @supadiff/targets exec vitest run --config vitest.integration.config.ts test/integration/peer-data-auth-rls.test.ts",
    "test:integration:upgrade-local": "pnpm --filter @supadiff/targets exec vitest run --config vitest.integration.config.ts test/integration/upgrade-local.test.ts",
    "test:fault-lab:replay": "vitest run --config vitest.root.config.ts test/fault-lab/fault-lab.test.ts test/fault-lab/replay.test.ts",
    "test:fault-lab:reduce": "vitest run --config vitest.root.config.ts test/fault-lab/reduce.test.ts",
    "test:integration:peer-storage": "pnpm --filter @supadiff/targets exec vitest run --config vitest.integration.config.ts test/integration/storage.test.ts test/integration/peer-storage-local.test.ts",
    "test:integration:hosted-smoke": "pnpm --filter @supadiff/targets exec vitest run --config vitest.integration.config.ts test/integration/hosted-smoke.test.ts",
    "test:generators": "pnpm --filter @supadiff/generators test",
    "test:generated-smoke": "pnpm --filter @supadiff/generators test:live-smoke",
    "docs:verify": "node scripts/docs-verify.mjs",
    "release:evidence": "node scripts/release-evidence.mjs",
    "supadiff": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/node": "22.10.2",
    "eslint": "9.15.0",
    "globals": "15.13.0",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vitest": "2.1.8",
    "@supadiff/spec": "workspace:*",
    "@supadiff/engine": "workspace:*",
    "@supadiff/targets": "workspace:*",
    "@supadiff/reducer": "workspace:*",
    "@supadiff/generators": "workspace:*",
    "supadiff": "workspace:*"
  }
}
